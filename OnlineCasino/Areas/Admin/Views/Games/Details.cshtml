@model OnlineCasino.Domain.Entities.Game

@{
    ViewData["Title"] = "Detail hry";
}

<h1>Detail hry</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.Id</dd>

        <dt class="col-sm-3">Název</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Popis</dt>
        <dd class="col-sm-9">@(Model.Description ?? "-")</dd>

        <dt class="col-sm-3">Minimální sázka</dt>
        <dd class="col-sm-9">@Model.MinBet Kč</dd>

        <dt class="col-sm-3">Maximální sázka</dt>
        <dd class="col-sm-9">@Model.MaxBet Kč</dd>

        <dt class="col-sm-3">Aktivní</dt>
        <dd class="col-sm-9">@(Model.IsActive ? "✅ Ano" : "❌ Ne")</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Upravit</a>
    <a asp-action="Index" class="btn btn-secondary">Zpět na seznam</a>
</div>
